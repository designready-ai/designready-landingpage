---
import Font from 'astro/components/Font.astro';
import SiteHeader from '../components/SiteHeader/SiteHeader.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	/** Used verbatim as <title>, bypassing the "— DesignReady" suffix. */
	titleOverride?: string;
	/** Emit a robots noindex meta (e.g. scratch/preview pages). */
	noindex?: boolean;
}

const SITE_NAME = 'DesignReady';
const DEFAULT_DESCRIPTION =
	'Figma plugin that scores your designs for AI-readiness in six dimensions, fixes common issues, and generates code prompts. Fully offline.';

const {
	title,
	description = DEFAULT_DESCRIPTION,
	ogImage = '/og-default.png',
	titleOverride,
	noindex = false,
} = Astro.props;

const fullTitle =
	titleOverride ?? (title === SITE_NAME ? SITE_NAME : `${title} — ${SITE_NAME}`);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<Font cssVariable="--font-inter" preload />

		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<script is:inline>
			(() => {
				const stored = localStorage.getItem('theme');
				const valid = stored === 'dark' || stored === 'light';
				const theme = valid ? stored : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				document.documentElement.setAttribute('data-theme', theme);
				// Motion on only when JS runs AND motion is welcome — set before
				// paint so reveal targets start hidden without a flash.
				if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
					document.documentElement.classList.add('motion');
				}
			})();
		</script>
	</head>
	<body class="bg-surface text-text font-sans antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:rounded-md focus:bg-surface-raised focus:border focus:border-brand focus:text-text"
		>
			Skip to content
		</a>

		<SiteHeader />

		<main id="main">
			<slot />
		</main>

		<!-- Scroll-reveal: add `.is-visible` as targets enter the viewport.
		     No-ops entirely unless `.motion` is set (JS + no reduced-motion). -->
		<script is:inline>
			(() => {
				const root = document.documentElement;
				if (!root.classList.contains('motion')) return;
				const els = document.querySelectorAll('[data-reveal], [data-reveal-stagger]');
				if (!els.length) return;
				if (!('IntersectionObserver' in window)) {
					els.forEach((el) => el.classList.add('is-visible'));
					return;
				}
				const io = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								io.unobserve(entry.target);
							}
						});
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
				);
				els.forEach((el) => io.observe(el));
			})();
		</script>
	</body>
</html>
