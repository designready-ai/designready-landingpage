---
import Base from '../layouts/Base.astro';
import CtaButton from '../components/CtaButton.astro';
---

<Base title="Page not found" description="This page could not be found.">
	<section
		class="mx-auto flex max-w-page flex-col items-center gap-6 px-4 py-section-y text-center sm:px-6"
	>
		<p class="text-sm font-semibold uppercase tracking-widest text-brand">
			404
		</p>
		<h1 class="text-4xl font-bold tracking-tight">Page not found</h1>
		<p class="max-w-prose text-lg text-text-muted">
			The page you are looking for does not exist or has moved.
		</p>
		<CtaButton href="/" variant="primary" size="lg">Back to home</CtaButton>
	</section>
</Base>
