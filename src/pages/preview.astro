---
// Scratch / preview page.
// Reachable in production but kept out of search: carries noindex and is
// excluded from the sitemap (astro.config.mjs). Safe to experiment here
// without touching index.astro.
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import ProblemSection from '../components/sections/ProblemSection.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import Features from '../components/sections/Features.astro';
import Privacy from '../components/sections/Privacy.astro';
import OpenSource from '../components/sections/OpenSource.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';

const FIGMA_URL =
	'https://www.figma.com/community/plugin/1619643293052051000/designready-ai';
const GITHUB_URL = 'https://github.com/designready-ai/designready-ai';
const CONTACT_EMAIL = 'design@stefan-holzheu.de';
const PERSONAL_URL = 'https://stefan-holzheu.de';
---

<Base
	title="Preview"
	titleOverride="Preview — DesignReady"
	noindex
>
	<Hero figmaUrl={FIGMA_URL} githubUrl={GITHUB_URL} />
	<ProblemSection />
	<HowItWorks />
	<Features />
	<Privacy />
	<OpenSource githubUrl={GITHUB_URL} />
	<FinalCta figmaUrl={FIGMA_URL} githubUrl={GITHUB_URL} />
	<SiteFooter
		figmaUrl={FIGMA_URL}
		githubUrl={GITHUB_URL}
		contactEmail={CONTACT_EMAIL}
		personalUrl={PERSONAL_URL}
	/>
</Base>
