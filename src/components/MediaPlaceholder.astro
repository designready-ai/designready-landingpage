---
/**
 * MediaPlaceholder — labelled ratio box standing in for a future image.
 *
 * Strictly token-bound (surface-raised fill, border, muted text) so it carries
 * contrast in both light and dark. Swap 1:1 for a lazy-loaded <img> later.
 *
 * @example
 * <MediaPlaceholder aspect="16/9" label="Score panel screenshot" />
 */
type Aspect = '1/1' | '3/4' | '4/3' | '16/9';

interface Props {
	/** Ratio of the box. Drives the aspect utility. */
	aspect?: Aspect;
	/** Optional caption shown centered inside the box. */
	label?: string;
}

const { aspect = '16/9', label } = Astro.props;

const aspectClass: Record<Aspect, string> = {
	'1/1': 'aspect-square',
	'3/4': 'aspect-portrait',
	'4/3': 'aspect-landscape',
	'16/9': 'aspect-video',
};
---

<div
	class:list={[
		'flex items-center justify-center w-full rounded-xl border border-dashed border-border bg-surface-raised p-4 text-center',
		aspectClass[aspect],
	]}
	role="img"
	aria-label={label ?? 'Placeholder image'}
>
	{
		label && (
			<span class="text-sm font-medium text-text-muted">{label}</span>
		)
	}
</div>
