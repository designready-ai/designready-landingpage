---
/**
 * HowItWorks — three-step flow: Scan, Fix, Prompt.
 * Each step carries a 1:1 illustration served via astro:assets <Picture>.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import scanImg from '../../assets/how-scan.png';
import fixImg from '../../assets/how-fix.png';
import promptImg from '../../assets/how-prompt.png';

interface Step {
	title: string;
	body: string;
	media: ImageMetadata;
	alt: string;
}

const STEPS: Step[] = [
	{
		title: 'Scan',
		body: 'Run DesignReady on a component or a whole selection. It scores six dimensions and shows what holds the design back.',
		media: scanImg,
		alt: 'A selected frame being scanned for AI-readiness',
	},
	{
		title: 'Fix',
		body: 'Apply quick fixes: auto-rename layers, convert dividers, remove hidden and empty nodes, and optimize Auto Layout with one click.',
		media: fixImg,
		alt: 'A wrench arranging layout blocks, representing quick fixes',
	},
	{
		title: 'Prompt',
		body: 'Once a component scores 75 or higher, export a token-optimized prompt with the full spec, a self-check block, and state hints.',
		media: promptImg,
		alt: 'A sparkle inside a scan frame, representing the generated AI prompt',
	},
];
---

<section
	id="how-it-works"
	aria-labelledby="how-it-works-heading"
	class="py-section-y"
>
	<div class="mx-auto max-w-page px-4 sm:px-6">
		<h2
			id="how-it-works-heading"
			class="text-3xl font-semibold tracking-tight"
		>
			Scan, fix, prompt
		</h2>
		<p class="mt-3 max-w-prose text-lg text-text-muted">
			Three steps from a rough design to a prompt an AI can build from.
		</p>

		<ol class="mt-10 grid gap-8 md:grid-cols-3">
			{
				STEPS.map((step, i) => (
					<li class="flex flex-col gap-4">
						<Picture
							src={step.media}
							formats={['avif', 'webp']}
							alt={step.alt}
							widths={[384, 768]}
							sizes="(min-width: 768px) 363px, 100vw"
							loading="lazy"
							class="h-auto w-full rounded-xl border border-border"
						/>
						<h3 class="text-xl font-semibold">
							{i + 1}. {step.title}
						</h3>
						<p class="leading-relaxed text-text-muted">{step.body}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>
