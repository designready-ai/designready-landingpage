---
/**
 * HowItWorks — three-step flow: Scan, Fix, Prompt.
 * Reuses the atomic-level brand illustrations as step markers.
 */
import MediaPlaceholder from '../MediaPlaceholder.astro';

interface Step {
	title: string;
	body: string;
	mediaLabel: string;
}

const STEPS: Step[] = [
	{
		title: 'Scan',
		body: 'Run DesignReady on a component or a whole selection. It scores six dimensions and shows what holds the design back.',
		mediaLabel: 'Score breakdown',
	},
	{
		title: 'Fix',
		body: 'Apply quick fixes: auto-rename layers, convert dividers, remove hidden and empty nodes, and optimize Auto Layout with one click.',
		mediaLabel: 'Quick fixes',
	},
	{
		title: 'Prompt',
		body: 'Once a component scores 75 or higher, export a token-optimized prompt with the full spec, a self-check block, and state hints.',
		mediaLabel: 'Prompt output',
	},
];
---

<section
	id="how-it-works"
	aria-labelledby="how-it-works-heading"
	class="py-section-y"
>
	<div class="mx-auto max-w-page px-4 sm:px-6">
		<h2
			id="how-it-works-heading"
			class="text-3xl font-semibold tracking-tight"
		>
			Scan, fix, prompt
		</h2>
		<p class="mt-3 max-w-prose text-lg text-text-muted">
			Three steps from a rough design to a prompt an AI can build from.
		</p>

		<ol class="mt-10 grid gap-8 md:grid-cols-3">
			<li class="flex flex-col gap-4">
				<MediaPlaceholder aspect="1/1" label={STEPS[0].mediaLabel} />
				<h3 class="text-xl font-semibold">1. {STEPS[0].title}</h3>
				<p class="leading-relaxed text-text-muted">{STEPS[0].body}</p>
			</li>
			<li class="flex flex-col gap-4">
				<MediaPlaceholder aspect="1/1" label={STEPS[1].mediaLabel} />
				<h3 class="text-xl font-semibold">2. {STEPS[1].title}</h3>
				<p class="leading-relaxed text-text-muted">{STEPS[1].body}</p>
			</li>
			<li class="flex flex-col gap-4">
				<MediaPlaceholder aspect="1/1" label={STEPS[2].mediaLabel} />
				<h3 class="text-xl font-semibold">3. {STEPS[2].title}</h3>
				<p class="leading-relaxed text-text-muted">{STEPS[2].body}</p>
			</li>
		</ol>
	</div>
</section>
