---
/**
 * SiteFooter — contact, links, social placeholders, legal.
 */
import { Icon } from 'astro-icon/components';

interface Props {
	figmaUrl: string;
	githubUrl: string;
	contactEmail: string;
	personalUrl: string;
}

const { figmaUrl, githubUrl, contactEmail, personalUrl } = Astro.props;
const year = new Date().getFullYear();

const linkClass =
	'inline-flex items-center gap-2 text-sm text-text-muted hover:text-brand transition-colors';
---

<footer
	id="footer"
	class="border-t border-border bg-surface-raised py-12"
>
	<div
		class="mx-auto grid max-w-page gap-10 px-4 sm:px-6 md:grid-cols-4"
	>
		<div class="flex flex-col gap-3">
			<span class="text-base font-bold tracking-tight">
				Design<span class="text-brand">Ready</span>
			</span>
			<p class="max-w-xs text-sm leading-relaxed text-text-muted">
				AI-readiness scoring and prompt generation for Figma components.
			</p>
		</div>

		<nav aria-label="Product" class="flex flex-col gap-2">
			<span class="text-sm font-semibold">Product</span>
			<a href={figmaUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
				<Icon name="lucide:figma" class="h-4 w-4" aria-hidden="true" />
				Figma Community
			</a>
			<a href={githubUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
				<Icon name="lucide:github" class="h-4 w-4" aria-hidden="true" />
				GitHub
			</a>
		</nav>

		<nav aria-label="Contact" class="flex flex-col gap-2">
			<span class="text-sm font-semibold">Contact</span>
			<a href={`mailto:${contactEmail}`} class={linkClass}>
				<Icon name="lucide:mail" class="h-4 w-4" aria-hidden="true" />
				{contactEmail}
			</a>
			<a href={personalUrl} target="_blank" rel="noopener noreferrer" class={linkClass}>
				<Icon name="lucide:globe" class="h-4 w-4" aria-hidden="true" />
				stefan-holzheu.de
			</a>
			<a href="https://www.linkedin.com/in/sholzheu" target="_blank" rel="noopener noreferrer" class={linkClass}>
				<Icon name="lucide:linkedin" class="h-4 w-4" aria-hidden="true" />
				LinkedIn
			</a>
			<a href="https://www.xing.com/profile/Stefan_Holzheu2" target="_blank" rel="noopener noreferrer" class={linkClass}>
				<Icon name="lucide:contact" class="h-4 w-4" aria-hidden="true" />
				XING
			</a>
		</nav>

		<nav aria-label="Legal" class="flex flex-col gap-2">
			<span class="text-sm font-semibold">Legal</span>
			<a href="/impressum" class={linkClass}>Legal notice</a>
			<a href="/datenschutz" class={linkClass}>Privacy</a>
		</nav>
	</div>

	<div
		class="mx-auto mt-10 max-w-page px-4 text-sm text-text-muted sm:px-6"
	>
		&copy; {year} DesignReady. Released under the MIT license.
	</div>
</footer>
