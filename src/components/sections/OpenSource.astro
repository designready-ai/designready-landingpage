---
/**
 * OpenSource — MIT license + Star on GitHub. Includes a 4:3 repo preview.
 */
import { Icon } from 'astro-icon/components';
import { Picture } from 'astro:assets';
import CtaButton from '../CtaButton.astro';
import repoPreview from '../../assets/opensource-repo.png';

interface Props {
	githubUrl: string;
}

const { githubUrl } = Astro.props;
---

<section
	id="open-source"
	aria-labelledby="open-source-heading"
	class="bg-surface-raised py-section-y"
>
	<div
		class="mx-auto grid max-w-page items-center gap-12 px-4 sm:px-6 md:grid-cols-2"
	>
		<div class="flex flex-col gap-5">
			<span
				class="inline-flex w-fit items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-sm font-medium text-text-muted"
			>
				<Icon name="lucide:scale" class="h-4 w-4" aria-hidden="true" />
				MIT licensed
			</span>
			<h2
				id="open-source-heading"
				class="text-3xl font-semibold tracking-tight"
			>
				Open source, top to bottom
			</h2>
			<p class="max-w-prose text-lg leading-relaxed text-text-muted">
				The full plugin lives on GitHub under the MIT license. Read the
				code, open an issue, or send a pull request.
			</p>
			<div>
				<CtaButton href={githubUrl} variant="ghost" size="lg">
					<Icon name="lucide:star" class="h-5 w-5" aria-hidden="true" />
					Star on GitHub
				</CtaButton>
			</div>
		</div>

		<div class="mx-auto w-full max-w-md">
			<Picture
				src={repoPreview}
				formats={['avif', 'webp']}
				alt="The DesignReady GitHub repository: MIT license, 15 stars, source folders, and the project description"
				widths={[448, 896]}
				sizes="448px"
				loading="lazy"
				class="h-auto w-full rounded-xl border border-border"
			/>
		</div>
	</div>
</section>
